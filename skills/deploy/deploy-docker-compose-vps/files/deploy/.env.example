# One environment's settings on the server: /srv/<APP>/production/.env or /srv/<APP>/staging/.env,
# readable by root alone (mode 600). deploy.sh makes it on the environment's first deploy, with
# secrets of its own; what's left to add by hand is the app's own settings, then
# `docker compose up -d` in that folder. Compose reads it for compose.yaml, and the app, the worker
# and the migrations get all of it as their environment. Values with a $ in them go in single quotes.

# Compose: the environment's project, and the loopback port nginx finds its app on.
# Production: <APP> and 3200. Staging: <APP>-staging and 3201. Ports nothing else on the host uses.
COMPOSE_PROJECT_NAME=<APP>
APP_PORT=3200
# The commit whose image runs. deploy.sh writes it; empty until the first deploy.
APP_TAG=
# The optional services to start besides the app and the database: `worker`, or empty for none.
COMPOSE_PROFILES=worker

# The database's password, hex, so the address compose.yaml builds from it needs no escaping:
#   openssl rand -hex 32
# Postgres keeps the one it was first started with: changing it here alone locks the app out.
POSTGRES_PASSWORD=

# The app's signing secret, 32 random bytes or more, each environment its own:
#   openssl rand -base64 32
# Changing it signs everyone out.
AUTH_SECRET=
# Production: https://<DOMAIN>. Staging: https://staging.<DOMAIN>.
APP_URL=https://<DOMAIN>

# The app's own settings follow (mail, third-party API keys, ...), each environment its own: staging
# never gets production's, and production's live here alone, never in GitHub.
